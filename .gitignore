# ==========================================
# PointList - Security & Build Git Ignore
# ==========================================

# 1. ARCHIVOS CON CREDENCIALES Y VARIABLES DE ENTORNO (CRÍTICO)
.env
.env.local
.env.*.local
*.env

# 2. CARPETAS DE COMPILACIÓN Y EJECUTABLES
build/
dist/
*.exe
*.dll
*.so
*.dylib
*.pyd

# 3. ARCHIVOS DE PYINSTALLER Y CACHÉ DE PYTHON
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.spec.bak

# 4. ALMACENAMIENTO DE DATOS LOCALES Y TEMPORALES
storage/data/*
storage/temp/*
!storage/data/.gitkeep
!storage/temp/.gitkeep

# 5. ENTORNOS VIRTUALES
venv/
env/
ENV/
.venv/

# 6. IDEs Y EDITORES DE CÓDIGO
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
