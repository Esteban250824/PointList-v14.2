# Configuración de Servidor Web
PORT=5000
HOST=0.0.0.0
APP_DEBUG=True

# Base de datos PostgreSQL (Opcional - Si no se configura, usará SQLite/LocalStorage)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pointlist

# OpenAI API Key (Para Asistente IA PointBit)
OPENAI_API_KEY=

# Idioma predeterminado (es, en, pt)
DEFAULT_LANGUAGE=es
