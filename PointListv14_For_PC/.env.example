# PointList - Configuración de Variables de Entorno
# 
# Copia este archivo a .env y completa con tus valores reales
# NO COMPARTIR ESTE ARCHIVO EN REPOSITORIOS PÚBLICOS

# ============================================================
# BASE DE DATOS - PostgreSQL
# ============================================================

# Host del servidor PostgreSQL
DB_HOST=localhost

# Puerto de PostgreSQL (por defecto 5432)
DB_PORT=5432

# Nombre de la base de datos
DB_NAME=pointlist

# Usuario de PostgreSQL
DB_USER=pointlist_user

# Contraseña del usuario (cambiar a una contraseña segura)
DB_PASSWORD=tu_contraseña_muy_segura_aqui

# ============================================================
# OPENAI API - ChatBot PointBit
# ============================================================

# Tu clave API de OpenAI (obtener en https://platform.openai.com/api-keys)
# Opcional: si no tienes esto, PointBit no funcionará
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de OpenAI a usar (gpt-3.5-turbo, gpt-4, etc.)
# OPENAI_MODEL=gpt-3.5-turbo

# ============================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================================

# Modo debug (True para desarrollo, False para producción)
APP_DEBUG=False

# Idioma por defecto (es, en, pt)
DEFAULT_LANGUAGE=es

# Zona horaria
TIMEZONE=America/Bogota

# ============================================================
# SEGURIDAD
# ============================================================

# Clave secreta para sesiones (generar una aleatoria larga)
# SECRET_KEY=tu_clave_secreta_aqui

# Tokens de autenticación
# AUTH_TOKEN_EXPIRY=3600

# ============================================================
# NOTAS IMPORTANTES
# ============================================================

# 1. Usa contraseñas seguras en producción
# 2. Nunca compartas este archivo en repositorios públicos
# 3. Usa valores diferentes para desarrollo y producción
# 4. Protege tu OPENAI_API_KEY - no compartir
# 5. Cambia DEFAULT_LANGUAGE según tu región

# Para desarrollo local, estos valores son aceptables:
# - localhost para DB_HOST
# - Tu usuario local para DB_USER
# - Una contraseña simple (cambiar en producción)

# Para producción:
# - Usar host remoto seguro
# - Contraseñas complejas
# - Usar RDS, Firebase o similar
# - Implementar SSL/TLS
